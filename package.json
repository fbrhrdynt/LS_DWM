{
  "name": "dwm",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "DWM - lightweight Node.js rewrite of the legacy Laravel application",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
