<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<main class="page">
  <div class="page-heading">
    <div>
      <p class="eyebrow">Maintenance</p>
      <h1>PM Documents</h1>
      <p class="muted">Procedures, checklists and maintenance reference files.</p>
    </div>
    <a class="secondary-button" href="/maintenance">PM Records</a>
  </div>

  <% if (notice) { %><div class="alert info"><%= notice %></div><% } %>

  <% if (['MASTER','Supervisor'].includes(user.level)) { %>
    <section class="panel">
      <div class="section-heading"><div><h2>Equipment / document categories</h2><p class="muted">These categories are also used by the asset list.</p></div></div>
      <form method="post" action="/maintenance/document-categories" class="form-grid compact-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label><span>Name</span><input name="name" required></label>
        <label class="full-field"><span>Notes</span><input name="notes"></label>
        <div class="form-actions"><button class="primary-button" type="submit">Add category</button></div>
      </form>
      <div class="responsive-list category-list">
        <% categories.forEach(category => { %>
          <article class="management-row">
            <form method="post" action="/maintenance/document-categories/<%= category.id %>/update" class="inline-edit-form">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input name="name" value="<%= category.name %>" required>
              <input name="notes" value="<%= category.notes || '' %>" placeholder="Notes">
              <span class="muted"><%= category.asset_count %> asset · <%= category.document_count %> file</span>
              <button class="secondary-button" type="submit">Save</button>
            </form>
            <% if (Number(category.asset_count) === 0 && Number(category.document_count) === 0) { %><form method="post" action="/maintenance/document-categories/<%= category.id %>/delete" onsubmit="return confirm('Delete this category?')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="danger-button" type="submit">Delete</button></form><% } %>
          </article>
        <% }) %>
      </div>
    </section>

    <section class="panel">
      <div class="section-heading"><div><h2>Upload document</h2><p class="muted">PDF, Word, Excel or PowerPoint up to 15 MB.</p></div></div>
      <% if (!categories.length) { %><div class="empty-state">Create a category before uploading a document.</div><% } else { %>
        <form method="post" action="/maintenance/documents/<%= categories[0].id %>" enctype="multipart/form-data" class="form-grid compact-form" data-document-upload-form>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <label><span>Category</span><select data-document-category><% categories.forEach(category => { %><option value="<%= category.id %>"><%= category.name %></option><% }) %></select></label>
          <label><span>Title</span><input name="title" required></label>
          <label><span>File</span><input name="file" type="file" accept=".pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx" required></label>
          <div class="form-actions"><button class="primary-button" type="submit">Upload document</button></div>
        </form>
      <% } %>
    </section>
  <% } %>

  <section class="panel">
    <div class="section-heading"><div><h2>Document library</h2><p class="muted"><%= documents.length %> file(s)</p></div></div>
    <% if (!documents.length) { %><div class="empty-state">No PM documents.</div><% } else { %>
      <div class="document-grid">
        <% documents.forEach(doc => { %>
          <article class="document-card">
            <div><span class="eyebrow"><%= doc.category_name || 'Document' %></span><strong><%= doc.title %></strong><p><%= doc.uploader_name || 'Unknown' %> · <%= Math.max(1, Math.round(Number(doc.file_size || 0) / 1024)) %> KB</p></div>
            <div class="row-actions">
              <a class="secondary-button" href="/maintenance/documents/<%= doc.id %>/download"><%= doc.hasFile ? 'Download' : 'File missing' %></a>
              <% if (['MASTER','Supervisor'].includes(user.level)) { %><form method="post" action="/maintenance/documents/<%= doc.id %>/delete" onsubmit="return confirm('Delete this document?')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="danger-button" type="submit">Delete</button></form><% } %>
            </div>
          </article>
        <% }) %>
      </div>
    <% } %>
  </section>
</main>

<script src="/static/js/maintenance.js?v=<%= assetVersion %>" defer></script>
<%- include('../partials/foot') %>
