<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<main class="page narrow-page">
  <div class="page-heading"><div><p class="eyebrow">Asset</p><h1><%= asset.asset_name %></h1><p class="muted"><%= asset.company_asset %> · <%= asset.mfg_sn %></p></div><a class="secondary-button" href="/assets">Back</a></div>
  <% if (notice) { %><div class="alert info"><%= notice %></div><% } %>
  <section class="panel"><dl class="kv-grid"><div><dt>Asset name</dt><dd><%= asset.asset_name %></dd></div><div><dt>Asset number</dt><dd><%= asset.company_asset %></dd></div><div><dt>Serial number</dt><dd><%= asset.mfg_sn %></dd></div><div><dt>Status</dt><dd><%= asset.status || '-' %></dd></div><div><dt>Project / Job</dt><dd><% if (asset.id_project) { %><a class="text-link" href="/projects/<%= asset.id_project %>/reports"><%= asset.operator_name || 'Project' %> · <%= asset.wellname || asset.drillingrig || '' %></a><% } else { %><span class="muted">Unassigned</span><% } %></dd></div><div><dt>Notes</dt><dd><%= asset.notes || '-' %></dd></div></dl></section>
  <% if (canManage) { %><section class="panel"><div class="section-heading"><h2>Edit asset</h2></div><form method="post" action="/assets/<%= asset.id %>/update" class="form-grid"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label><span>Asset name</span><input name="asset_name" value="<%= asset.asset_name %>" required></label><label><span>Asset number</span><input name="company_asset" value="<%= asset.company_asset %>" required></label><label><span>Manufacturer serial number</span><input name="mfg_sn" value="<%= asset.mfg_sn %>" required></label><label><span>Project / Job</span><select name="id_project" required><% projects.forEach(p => { %><option value="<%= p.id_project %>" <%= Number(asset.id_project) === Number(p.id_project) ? 'selected' : '' %>><%= p.operator_name %> · <%= p.wellname || p.drillingrig || p.contract %></option><% }) %></select></label><label><span>Status</span><select name="status"><% ['Active','Standby','Repair','Inactive'].forEach(s => { %><option value="<%= s %>" <%= asset.status === s ? 'selected' : '' %>><%= s %></option><% }) %></select></label><label class="full-field"><span>Notes</span><textarea name="notes" rows="3"><%= asset.notes || '' %></textarea></label><div class="form-actions"><button class="primary-button" type="submit">Save changes</button></div></form><form method="post" action="/assets/<%= asset.id %>/delete" onsubmit="return confirm('Delete this asset?')" style="margin-top:12px"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="danger-button" type="submit">Delete asset</button></form></section><% } %>
</main>
<%- include('../partials/foot') %>
