<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<main class="page asset-detail-page">
  <div class="page-heading">
    <div>
      <p class="eyebrow"><%= asset.company_asset %></p>
      <h1><%= asset.asset_name %></h1>
      <p class="muted"><%= asset.category_name || 'Uncategorized' %> · S/N <%= asset.mfg_sn || '-' %></p>
    </div>
    <a class="secondary-button" href="/assets">Back to assets</a>
  </div>

  <% if (notice) { %><div class="alert info"><%= notice %></div><% } %>

  <section class="panel">
    <div class="section-heading"><div><h2>Asset information</h2><p class="muted">Current status and COC.</p></div></div>
    <div class="detail-grid">
      <div><span>Company asset</span><strong><%= asset.company_asset %></strong></div>
      <div><span>Manufacturer S/N</span><strong><%= asset.mfg_sn %></strong></div>
      <div><span>Status</span><strong><%= asset.status || '-' %></strong></div>
      <div><span>COC</span><strong><%= asset.coc ? (asset.cocExists ? 'Available' : 'File missing') : 'Not uploaded' %></strong></div>
    </div>
    <% if (asset.notes) { %><p class="asset-notes"><%= asset.notes %></p><% } %>
    <% if (asset.coc && asset.cocExists) { %><a class="secondary-button inline-button" href="/assets/<%= asset.id %>/coc">Download COC</a><% } %>
  </section>

  <% if (canManage) { %>
    <details class="panel collapsible-panel">
      <summary>Edit asset</summary>
      <form method="post" action="/assets/<%= asset.id %>/update" enctype="multipart/form-data" class="form-grid details-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label><span>Asset name</span><input name="asset_name" value="<%= asset.asset_name %>" required></label>
        <label><span>Company asset</span><input name="company_asset" value="<%= asset.company_asset %>" required></label>
        <label><span>Manufacturer S/N</span><input name="mfg_sn" value="<%= asset.mfg_sn %>" required></label>
        <label><span>Category</span><select name="id_pm_category" required><% categories.forEach(category => { %><option value="<%= category.id %>" <%= Number(asset.id_pm_category) === Number(category.id) ? 'selected' : '' %>><%= category.name %></option><% }) %></select></label>
        <label><span>Status</span><select name="status"><% ['Active','Maintenance','Standby','Inactive'].forEach(status => { %><option value="<%= status %>" <%= asset.status === status ? 'selected' : '' %>><%= status %></option><% }) %></select></label>
        <label><span>Replace COC</span><input name="coc" type="file" accept=".pdf,.doc,.docx"></label>
        <label class="full-field"><span>Notes</span><textarea name="notes" rows="3"><%= asset.notes || '' %></textarea></label>
        <div class="form-actions"><button class="primary-button" type="submit">Save asset</button></div>
      </form>
      <form method="post" action="/assets/<%= asset.id %>/delete" onsubmit="return confirm('Delete this asset and all inspection/PM records?')" class="danger-zone-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="danger-button" type="submit">Delete asset</button>
      </form>
    </details>
  <% } %>

  <section class="panel" id="inspection">
    <div class="section-heading">
      <div><h2>Inspection</h2><p class="muted">Certificate validity is calculated automatically from the expiry date.</p></div>
      <a class="secondary-button" href="/inspection">All inspections</a>
    </div>

    <% if (canManage) { %>
      <form method="post" action="/assets/<%= asset.id %>/inspections" enctype="multipart/form-data" class="form-grid compact-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label><span>Inspection type</span><select name="id_inspection" required><option value="">Select type</option><% inspectionCategories.forEach(category => { %><option value="<%= category.id_inspection %>"><%= category.name_inspection %></option><% }) %></select></label>
        <label><span>Inspection date</span><input name="inspection_date" type="date" value="<%= today %>" required></label>
        <label><span>Expiry date</span><input name="inspection_exp" type="date" required></label>
        <label><span>Certificate</span><input name="cert" type="file" accept=".pdf,.doc,.docx"></label>
        <label class="full-field"><span>Notes</span><input name="notes"></label>
        <div class="form-actions"><button class="primary-button" type="submit">Save inspection</button></div>
      </form>
    <% } %>

    <% if (!inspections.length) { %><div class="empty-state">No inspection records.</div><% } else { %>
      <div class="responsive-list">
        <% inspections.forEach(record => { %>
          <article class="management-row">
            <div class="management-main">
              <strong><%= record.name_inspection || 'Inspection' %></strong>
              <p><%= record.inspection_date || '-' %> → <%= record.inspection_exp || '-' %></p>
              <div class="meta-row"><span class="badge due-<%= record.dueState.key %>"><%= record.dueState.label %></span><% if (record.notes) { %><span class="muted"><%= record.notes %></span><% } %></div>
            </div>
            <div class="row-actions">
              <% if (record.cert) { %><a class="secondary-button" href="/inspections/<%= record.id %>/certificate"><%= record.hasFile ? 'Certificate' : 'File missing' %></a><% } %>
              <% if (canManage) { %><form method="post" action="/inspections/<%= record.id %>/delete" onsubmit="return confirm('Delete this inspection record?')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="danger-button" type="submit">Delete</button></form><% } %>
            </div>
          </article>
        <% }) %>
      </div>
    <% } %>
  </section>

  <section class="panel" id="maintenance">
    <div class="section-heading">
      <div><h2>Preventive maintenance</h2><p class="muted">PM Due = PM Start + category frequency. Due date is recalculated by the server.</p></div>
      <a class="secondary-button" href="/maintenance">All PM</a>
    </div>

    <% if (canManage) { %>
      <form method="post" action="/assets/<%= asset.id %>/maintenance" class="form-grid compact-form" data-pm-form>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label><span>PM category</span><select name="id_pm_detail_category" data-pm-category required><option value="">Select PM</option><% maintenanceCategories.forEach(category => { %><option value="<%= category.id %>" data-frequency="<%= category.frequency %>" data-unit="<%= category.frequency_unit %>"><%= category.pm_name %> · <%= category.frequency %> <%= category.frequency_unit %></option><% }) %></select></label>
        <label><span>PM start</span><input name="pm_start" type="date" value="<%= today %>" data-pm-start required></label>
        <label><span>PM due <span class="auto-chip">Auto</span></span><input type="date" data-pm-due readonly></label>
        <label><span>Status</span><select name="pm_status"><% ['Scheduled','Completed','Deferred','Cancelled'].forEach(status => { %><option value="<%= status %>"><%= status %></option><% }) %></select></label>
        <label><span>Performed by</span><input name="performed_by" value="<%= user.employee_name || '' %>" required></label>
        <label class="full-field"><span>Notes</span><input name="notes"></label>
        <div class="form-actions"><button class="primary-button" type="submit">Add PM record</button></div>
      </form>
    <% } %>

    <% if (!maintenance.length) { %><div class="empty-state">No PM records.</div><% } else { %>
      <div class="responsive-list">
        <% maintenance.forEach(record => { %>
          <article class="management-row">
            <div class="management-main">
              <strong><%= record.pm_name || 'Preventive Maintenance' %></strong>
              <p><%= record.pm_start || '-' %> → <%= record.pm_due || '-' %> · <%= record.performed_by || '-' %></p>
              <div class="meta-row"><span class="badge"><%= record.pm_status || '-' %></span><span class="badge due-<%= record.dueState.key %>"><%= record.dueState.label %></span><% if (record.notes) { %><span class="muted"><%= record.notes %></span><% } %></div>
            </div>
            <% if (canManage) { %>
              <div class="row-actions">
                <form method="post" action="/maintenance/records/<%= record.id %>/update" class="inline-status-form">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <input type="hidden" name="id_pm_detail_category" value="<%= record.id_pm_detail_category %>">
                  <input type="hidden" name="pm_start" value="<%= record.pm_start %>">
                  <input type="hidden" name="performed_by" value="<%= record.performed_by || '' %>">
                  <select name="pm_status" aria-label="PM status"><% ['Scheduled','Completed','Deferred','Cancelled'].forEach(status => { %><option value="<%= status %>" <%= record.pm_status === status ? 'selected' : '' %>><%= status %></option><% }) %></select>
                  <button class="secondary-button" type="submit">Update</button>
                </form>
                <form method="post" action="/maintenance/records/<%= record.id %>/delete" onsubmit="return confirm('Delete this PM record?')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="danger-button" type="submit">Delete</button></form>
              </div>
            <% } %>
          </article>
        <% }) %>
      </div>
    <% } %>
  </section>
</main>

<script src="/static/js/maintenance.js?v=<%= assetVersion %>" defer></script>
<%- include('../partials/foot') %>
