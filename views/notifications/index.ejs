<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<main class="page">
  <div class="page-heading">
    <div>
      <p class="eyebrow">Due & expiry</p>
      <h1>Notifications</h1>
      <p class="muted">Preventive maintenance and inspection items due within the next 30 days.</p>
    </div>
  </div>

  <section class="notification-summary-grid">
    <article class="stat-card"><span>Overdue / expired</span><strong><%= summary.overdue %></strong></article>
    <article class="stat-card"><span>Due ≤7 days</span><strong><%= summary.due7 %></strong></article>
    <article class="stat-card"><span>Due 8–30 days</span><strong><%= summary.due30 %></strong></article>
    <article class="stat-card"><span>Total attention</span><strong><%= summary.total %></strong></article>
  </section>

  <section class="panel notification-list-panel">
    <% if (!notifications.length) { %>
      <div class="empty-state">
        <strong>No due items.</strong>
        <p class="muted">Nothing is overdue or due in the next 30 days.</p>
      </div>
    <% } %>

    <% notifications.forEach(item => { %>
      <a class="notification-row severity-<%= item.severity %>" href="<%= item.href %>">
        <div>
          <strong><%= item.title %></strong>
          <p><%= item.message %> · <%= item.dueDate %></p>
        </div>
        <span class="notification-type"><%= item.type === 'inspection' ? 'Inspection' : 'PM' %></span>
      </a>
    <% }) %>
  </section>
</main>

<%- include('../partials/foot') %>
