<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<main class="page">
  <div class="page-heading">
    <div>
      <p class="eyebrow"><%= project.contract || 'Project' %></p>
      <h1><%= project.operator_name || 'Reports' %></h1>
      <p class="muted"><%= project.drillingrig || '' %> <%= project.wellname ? `· ${project.wellname}` : '' %></p>
    </div>
    <a class="secondary-button" href="/projects">Projects</a>
  </div>

  <% if (!reports.length) { %>
    <div class="empty-state">No daily reports have been created for this project.</div>
  <% } else { %>
    <div class="table-wrap">
      <table class="data-table">
        <thead>
          <tr>
            <th>No.</th>
            <th>Date</th>
            <th>Well</th>
            <th>Location</th>
            <th>Status</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% reports.forEach(report => { %>
            <tr>
              <td><%= report.urut || '-' %></td>
              <td><%= report.curdate || '-' %></td>
              <td><%= report.wellname || '-' %></td>
              <td><%= report.location || '-' %></td>
              <td>
                <span class="badge <%= report.lockreport === 'YES' ? 'badge-muted' : 'badge-success' %>">
                  <%= report.lockreport === 'YES' ? 'Locked' : 'Open' %>
                </span>
              </td>
              <td class="table-action">
                <a class="text-link" href="/projects/<%= project.id_project %>/reports/<%= report.id_wellinfo %>">Open →</a>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</main>

<%- include('../partials/foot') %>
