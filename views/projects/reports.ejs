<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<main class="page">
  <div class="page-heading">
    <div><p class="eyebrow"><%= project.contract || 'Project' %></p><h1><%= project.operator_name || 'Reports' %></h1><p class="muted"><%= project.drillingrig || '' %> <%= project.wellname ? `· ${project.wellname}` : '' %></p></div>
    <div class="heading-actions">
      <form method="post" action="/projects/<%= project.id_project %>/reports/new"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="primary-button" type="submit">Create next report</button></form>
      <% if (isManager) { %><a class="secondary-button" href="/projects/<%= project.id_project %>/summary.xlsx">Excel summary</a><% } %><a class="secondary-button" href="/projects">Projects</a>
    </div>
  </div>
  <% if (notice) { %><div class="alert info"><%= notice %></div><% } %>
  <section class="panel">
    <div class="section-heading"><div><h2>Daily reports</h2><p class="muted">Validation is used for crew handover. A validated report stays visible to Operators, but Operator editing is frozen until Supervisor/Admin re-opens it.</p></div></div>
    <% if (!reports.length) { %><div class="empty-state">No daily reports have been created.</div><% } else { %>
    <div class="table-wrap"><table class="data-table"><thead><tr><th>No.</th><th>Date</th><th>Well</th><th>Created by</th><th>Status</th><th></th></tr></thead><tbody>
      <% reports.forEach(report => { const viewOnly = !isManager && report.validation_status === 'VALIDATED'; %><tr>
        <td><%= formatReportNo(report.urut, '-') %></td><td><%= report.curdate || '-' %></td><td><%= report.wellname || '-' %></td><td><%= report.created_by_name || '-' %></td>
        <td><span class="badge <%= report.validation_status === 'VALIDATED' ? 'badge-success' : report.validation_status === 'PENDING' ? 'badge-warning' : 'badge-muted' %>"><%= report.validation_status === 'PENDING' ? 'Pending validation' : report.validation_status === 'VALIDATED' ? 'Validated' : 'Draft' %></span><% if (report.validated_by_name) { %><small class="muted" style="display:block;margin-top:4px">by <%= report.validated_by_name %></small><% } %></td>
        <td class="table-action">
          <div class="row-actions compact-actions">
            <a class="text-link" href="/projects/<%= project.id_project %>/reports/<%= report.id_wellinfo %>">Open →</a><% if (viewOnly) { %><span class="muted">View only</span><% } %>
            <% if (isManager) { %>
              <% if (report.validation_status === 'VALIDATED') { %>
                <form method="post" action="/projects/<%= project.id_project %>/reports/<%= report.id_wellinfo %>/reopen"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="secondary-button compact-button" type="submit">Re-open</button></form>
              <% } else { %>
                <form method="post" action="/projects/<%= project.id_project %>/reports/<%= report.id_wellinfo %>/validate"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="primary-button compact-button" type="submit">Validate</button></form>
              <% } %>
            <% } %>
          </div>
        </td>
      </tr><% }) %>
    </tbody></table></div><% } %>
  </section>
  <section class="panel"><div class="section-heading"><div><h2>Assigned assets</h2><p class="muted">Assets linked to this project / job.</p></div><a class="secondary-button" href="/assets">Assets</a></div>
    <% if (!assets.length) { %><div class="empty-state">No assets assigned to this project.</div><% } else { %><div class="responsive-list"><% assets.forEach(a => { %><article class="management-row"><div class="management-main"><strong><%= a.asset_name %></strong><p><%= a.company_asset %> · <%= a.mfg_sn %></p><div class="meta-row"><span class="badge <%= a.status === 'Active' ? 'badge-success' : 'badge-muted' %>"><%= a.status || '-' %></span></div></div><a class="secondary-button" href="/assets/<%= a.id %>">Open</a></article><% }) %></div><% } %>
  </section>
</main>
<%- include('../partials/foot') %>
