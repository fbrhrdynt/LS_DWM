<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<main class="page narrow-page">
  <div class="page-heading">
    <div>
      <p class="eyebrow">Projects</p>
      <h1>Edit project</h1>
      <p class="muted"><%= project.operator_name || project.contract %></p>
    </div>
    <a class="secondary-button" href="/projects">Back</a>
  </div>

  <% if (error) { %><div class="alert error"><%= error %></div><% } %>

  <section class="panel">
    <form method="post" action="/projects/<%= project.id_project %>/update" class="form-grid">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <label>
        <span>Contract</span>
        <input name="contract" maxlength="20" value="<%= project.contract || '' %>" required>
      </label>

      <label>
        <span>Operator</span>
        <input name="operator_name" maxlength="255" value="<%= project.operator_name || '' %>" required>
      </label>

      <label>
        <span>Drilling rig</span>
        <input name="drillingrig" maxlength="255" value="<%= project.drillingrig || '' %>" required>
      </label>

      <label>
        <span>Well name</span>
        <input name="wellname" maxlength="255" value="<%= project.wellname || '' %>" required>
      </label>

      <label>
        <span>Report access code</span>
        <input name="kodeakses" inputmode="numeric" pattern="[0-9]{4,10}" maxlength="10" value="<%= project.kodeakses || '' %>" required>
      </label>

      <div class="form-actions">
        <button class="primary-button" type="submit">Save changes</button>
        <a class="secondary-button" href="/projects">Cancel</a>
      </div>
    </form>
  </section>
</main>

<%- include('../partials/foot') %>
