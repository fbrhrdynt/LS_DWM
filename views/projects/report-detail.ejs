<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<main class="page">
  <div class="page-heading report-heading">
    <div><p class="eyebrow"><%= project.contract || 'Project' %> · Daily Report <%= formatReportNo(report.urut, report.id_wellinfo) %></p><h1><%= report.wellname || project.wellname || 'Well report' %></h1><p class="muted"><%= report.curdate || '-' %> · <%= report.location || 'Location not set' %></p></div>
    <div class="heading-actions">
      <span class="badge <%= report.validation_status === 'VALIDATED' ? 'badge-success' : report.validation_status === 'PENDING' ? 'badge-warning' : 'badge-muted' %>"><%= report.validation_status === 'PENDING' ? 'Pending validation' : report.validation_status === 'VALIDATED' ? 'Validated' : 'Draft' %></span>
      <% if (canEdit) { %><a class="primary-button" href="/projects/<%= project.id_project %>/reports/<%= report.id_wellinfo %>/edit?section=report">Edit report</a><% } else { %><span class="badge badge-muted">View only for Operator</span><% } %>
      <a class="secondary-button" href="/projects/<%= project.id_project %>/reports/<%= report.id_wellinfo %>/pdf" target="_blank" rel="noopener">View PDF</a>
      <a class="secondary-button" href="/projects/<%= project.id_project %>/reports">Reports</a>
    </div>
  </div>
  <% if (notice) { %><div class="alert info"><%= notice %></div><% } %>

  <section class="panel report-actions-panel"><div class="report-actions-copy"><strong>Handover validation</strong><span class="muted"><%= isManager ? 'Validate when a crew handover should freeze Operator editing. Supervisor/Admin can always edit.' : (report.validation_status === 'VALIDATED' ? 'Validated: you can view and download the PDF, but editing is frozen.' : 'You can keep editing until Supervisor/Admin validates this report for handover.') %></span></div><div class="row-actions report-control-actions">
    <% if (isManager) { %>
      <% if (report.validation_status === 'VALIDATED') { %><form method="post" action="/projects/<%= project.id_project %>/reports/<%= report.id_wellinfo %>/reopen"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="secondary-button" type="submit">Re-open for Operator</button></form><% } else { %><form method="post" action="/projects/<%= project.id_project %>/reports/<%= report.id_wellinfo %>/validate"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="primary-button" type="submit">Validate report</button></form><% } %>
    <% } %>
    <form method="post" action="/projects/<%= project.id_project %>/reports/<%= report.id_wellinfo %>/copy"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="secondary-button" type="submit">Copy as next report</button></form>
    <% if (canEdit) { %><form method="post" action="/projects/<%= project.id_project %>/reports/<%= report.id_wellinfo %>/recalculate"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="secondary-button" type="submit">Recalculate formulas</button></form><% } %>
    <% if (isManager) { %><form method="post" action="/projects/<%= project.id_project %>/reports/<%= report.id_wellinfo %>/delete" onsubmit="return confirm('Delete this daily report?')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="danger-button" type="submit">Delete</button></form><% } %>
  </div></section>

  <section class="detail-grid"><article class="panel detail-card"><div class="section-heading"><h2>Well information</h2></div><dl class="kv-grid">
    <div><dt>Platform</dt><dd><%= report.platform || '-' %></dd></div><div><dt>Well</dt><dd><%= report.wellname || '-' %></dd></div><div><dt>Spud date</dt><dd><%= report.spud_date || '-' %></dd></div><div><dt>Location</dt><dd><%= report.location || '-' %></dd></div><div><dt>Company man</dt><dd><%= report.companyman || '-' %></dd></div><div><dt>OIM</dt><dd><%= report.oim || '-' %></dd></div><div><dt>Report no.</dt><dd><%= formatReportNo(report.urut, '-') %></dd></div><div><dt>Status</dt><dd><%= report.validation_status || 'DRAFT' %></dd></div>
  </dl></article><article class="panel detail-card"><div class="section-heading"><h2>Active mud properties</h2></div><dl class="kv-grid"><div><dt>Fluid type</dt><dd><%= details.fluidtype || '-' %></dd></div><div><dt>Current depth</dt><dd><%= details.curdepth ?? '-' %></dd></div><div><dt>Mud weight</dt><dd><%= details.mudweight ?? '-' %> <%= details.mwunit || '' %></dd></div><div><dt>PV</dt><dd><%= details.pv ?? '-' %></dd></div><div><dt>YP</dt><dd><%= details.yp ?? '-' %></dd></div><div><dt>Active system volume</dt><dd><%= details.activesysvol ?? '-' %></dd></div></dl></article></section>

  <section class="panel"><div class="section-heading"><h2>Equipment snapshot</h2></div><div class="equipment-grid three-up"><% [1,2,3].forEach(n => { %><article class="equipment-card"><span class="equipment-label">Centrifuge <%= n %></span><strong><%= details[`cf${n}_sn`] || '-' %></strong><p><%= details[`cf${n}_model`] || 'Model not set' %></p><dl><div><dt>Mode</dt><dd><%= details[`cf${n}_modeofopr`] || '-' %></dd></div><div><dt>Run hour</dt><dd><%= details[`cf${n}_runninghour`] ?? '-' %></dd></div></dl></article><% }) %></div></section>
  <section class="detail-grid"><article class="panel detail-card"><div class="section-heading"><h2>Waste & solids</h2></div><dl class="kv-grid"><div><dt>Daily waste</dt><dd><%= dailyWaste.dailywaste_generated ?? '-' %></dd></div><div><dt>Average MOC</dt><dd><%= dailyWaste.avg_moc ?? '-' %></dd></div><div><dt>Bypassed %</dt><dd><%= bypassed.percentage ?? '-' %></dd></div><div><dt>Cumulative oil</dt><dd><%= retort.cum_oil ?? '-' %></dd></div></dl></article><article class="panel detail-card"><div class="section-heading"><h2>Personnel</h2></div><dl class="kv-grid"><div><dt>Day shift 1</dt><dd><%= personnel.ds1_name || '-' %></dd></div><div><dt>Day shift 2</dt><dd><%= personnel.ds2_name || '-' %></dd></div><div><dt>Night shift 1</dt><dd><%= personnel.ns1_name || '-' %></dd></div><div><dt>Night shift 2</dt><dd><%= personnel.ns2_name || '-' %></dd></div></dl></article></section>
  <section class="panel"><div class="section-heading"><h2>Activities</h2></div><div class="activity-grid"><div><span class="field-label"><%= reportSettings?.pdf_activity_label || 'BSS Activity' %></span><p class="activity-text"><%= additional.bssactivity || 'No activity recorded.' %></p></div><div><span class="field-label">Rig activity</span><p class="activity-text"><%= additional.rigactivity || 'No activity recorded.' %></p></div></div></section>
</main>
<%- include('../partials/foot') %>
