<%- include('../partials/head') %>
<main class="auth-shell">
  <section class="login-panel">
    <div class="login-toolbar">
      <a class="brand brand-login" href="/login">
        <span class="brand-mark">D</span>
        <span>DWM</span>
      </a>
      <button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch color theme">
        <span class="theme-dot" aria-hidden="true"></span>
        <span data-theme-label>Dark</span>
      </button>
    </div>

    <h1>Forgot password</h1>
    <p class="muted">Enter the email registered on your DWM account.</p>

    <% if (notice) { %><div class="alert info"><%= notice %></div><% } %>
    <% if (error) { %><div class="alert error"><%= error %></div><% } %>

    <form method="post" action="/forgot-password" class="form-stack">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <label>
        <span>Email</span>
        <input name="email" type="email" autocomplete="email" required autofocus>
      </label>

      <button class="primary-button" type="submit">Send reset link</button>
    </form>

    <% if (devResetLink) { %>
      <div class="alert warning">
        Development only: <a href="<%= devResetLink %>">open reset link</a>.
      </div>
    <% } %>

    <div class="auth-links">
      <a href="/login">Back to sign in</a>
    </div>
  </section>
</main>
<%- include('../partials/foot') %>
