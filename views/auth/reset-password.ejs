<%- include('../partials/head') %>
<main class="auth-shell">
  <section class="login-panel">
    <div class="login-toolbar">
      <a class="brand brand-login" href="/login">
        <span class="brand-mark">D</span>
        <span>DWM</span>
      </a>
      <button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch color theme">
        <span class="theme-dot" aria-hidden="true"></span>
        <span data-theme-label>Dark</span>
      </button>
    </div>

    <h1>Reset password</h1>
    <p class="muted">Set a new password for <strong><%= accountName || 'your account' %></strong>.</p>

    <% if (error) { %><div class="alert error"><%= error %></div><% } %>

    <form method="post" action="/reset-password" class="form-stack">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="token" value="<%= token %>">

      <label>
        <span>New password</span>
        <input name="pass_login" type="password" minlength="8" autocomplete="new-password" required autofocus>
      </label>

      <label>
        <span>Confirm new password</span>
        <input name="pass_login_confirmation" type="password" minlength="8" autocomplete="new-password" required>
      </label>

      <button class="primary-button" type="submit">Update password</button>
    </form>
  </section>
</main>
<%- include('../partials/foot') %>
