<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <meta name="theme-color" id="themeColorMeta" content="#f7f9fc">
  <script>
    (() => {
      try {
        const saved = localStorage.getItem('dwm-theme');
        const theme = saved === 'dark' || saved === 'light'
          ? saved
          : (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.dataset.theme = theme;
        document.getElementById('themeColorMeta')?.setAttribute('content', theme === 'dark' ? '#101419' : '#f7f9fc');
      } catch {
        document.documentElement.dataset.theme = 'light';
      }
    })();
  </script>
  <title><%= title ? `${title} · ${appName}` : appName %></title>
  <link rel="stylesheet" href="/static/css/app.css?v=<%= assetVersion %>">
</head>
<body>
