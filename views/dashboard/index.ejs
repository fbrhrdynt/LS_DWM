<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<main class="page">
  <div class="page-heading">
    <div>
      <p class="eyebrow">Overview</p>
      <h1>Dashboard</h1>
    </div>
    <p class="muted">Signed in as <strong><%= user.level %></strong></p>
  </div>

  <section class="stats-grid" aria-label="Summary">
    <article class="stat-card">
      <span>Projects</span>
      <strong><%= stats.projects %></strong>
    </article>
    <article class="stat-card">
      <span>Reports</span>
      <strong><%= stats.reports %></strong>
    </article>
    <article class="stat-card">
      <span>Assets</span>
      <strong><%= stats.assets %></strong>
    </article>
    <article class="stat-card">
      <span>Active users</span>
      <strong><%= stats.users %></strong>
    </article>
    <a class="stat-card stat-link" href="/inspection">
      <span>Inspection due ≤30d</span>
      <strong><%= stats.inspectionDue %></strong>
    </a>
    <a class="stat-card stat-link" href="/maintenance">
      <span>PM due ≤30d</span>
      <strong><%= stats.pmDue %></strong>
    </a>
  </section>

  <% if (notifications && notifications.length) { %>
    <section class="panel dashboard-alerts">
      <div class="section-heading">
        <div>
          <h2>Needs attention</h2>
          <p class="muted"><%= notificationStats.overdue %> overdue/expired · <%= notificationStats.due7 %> due within 7 days</p>
        </div>
        <a class="secondary-button" href="/notifications">View all</a>
      </div>
      <div class="notification-compact-list">
        <% notifications.forEach(item => { %>
          <a href="<%= item.href %>" class="notification-compact severity-<%= item.severity %>">
            <div><strong><%= item.title %></strong><span><%= item.message %></span></div>
            <small><%= item.dueDate %></small>
          </a>
        <% }) %>
      </div>
    </section>
  <% } %>
</main>

<%- include('../partials/foot') %>
