NODE_ENV=production
APP_NAME=DWM
APP_URL=https://dwm.example.com
APP_TIMEZONE=Asia/Jakarta
HOST=127.0.0.1
PORT=3020

SESSION_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
SQLITE_PATH=data/dwm.sqlite

TRUST_PROXY=1

# Session/security
SESSION_MAX_HOURS=8
SESSION_SECRET_PREVIOUS=
PASSWORD_RESET_TTL_MINUTES=15
AUDIT_RETENTION_DAYS=180

# SMTP for Forgot Password
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="DWM <dwm@example.com>"

# Optional ownCloud / WebDAV backup target
OWNCLOUD_BASE_URI=
OWNCLOUD_USERNAME=
OWNCLOUD_PASSWORD=
WEBDAV_BACKUP_PATH=DWM-Backups
WEBDAV_TIMEOUT_MS=15000


BACKUP_RETENTION_DAYS=14
